# Keep these server-side only; DATABASE_URL is backend/service-only and never frontend.
AI_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-shared-secret
DATABASE_URL=postgresql://user:password@host:5432/database
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
LOCAL_EMBEDDING_PROVIDER=onnx
# Optional; default: ~/.cache/careerpilot-ai/minilm-onnx
LOCAL_EMBEDDING_CACHE_DIR=C:/careerpilot-ai/model-cache
