# Copy to .env for local development. Do not commit real credentials.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL="YOUR_TRANSACTION_POOLER_CONNECTION_STRING"
DIRECT_URL="YOUR_SESSION_POOLER_CONNECTION_STRING"
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
SUPABASE_RESUME_BUCKET=resumes
GROQ_API_KEY="YOUR_SERVER_SIDE_GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-20b
RESUME_MAX_SIZE_BYTES=10485760
