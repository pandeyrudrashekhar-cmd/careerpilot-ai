{
  "name": "careerpilot-backend",
  "version": "0.1.0",
  "description": "CareerPilot AI — Express + TypeScript backend API",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
