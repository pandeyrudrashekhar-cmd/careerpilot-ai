    "express": "^4.21.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "jose": "^6.2.15",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^1.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.0",
    "prisma": "^6.19.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
