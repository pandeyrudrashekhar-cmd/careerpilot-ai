# ============================================================
# CareerPilot AI — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env files with real credentials.
# ============================================================

# -----------------------------------------------
# Backend (Node.js / Express)
# -----------------------------------------------
NODE_ENV=development
PORT=3001

# -----------------------------------------------
# Database (Supabase / PostgreSQL)
# -----------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/careerpilot
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/careerpilot

# Supabase project credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------
# AI Service (Python / FastAPI)
# -----------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (optional fallback)
OPENAI_API_KEY=your-openai-api-key

# LangSmith (optional — LangChain tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=careerpilot-ai

# -----------------------------------------------
# Frontend (Vite — must be prefixed with VITE_)
# -----------------------------------------------
VITE_API_BASE_URL=http://localhost:3001/api
VITE_AI_SERVICE_URL=http://localhost:8000

# -----------------------------------------------
# Auth (future — e.g. Clerk or JWT)
# -----------------------------------------------
JWT_SECRET=your-secret-key-minimum-32-characters
# CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
# CLERK_SECRET_KEY=your-clerk-secret-key

# -----------------------------------------------
# Miscellaneous
# -----------------------------------------------
LOG_LEVEL=debug
