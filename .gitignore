# ============================================================
# CareerPilot AI — Root .gitignore
# ============================================================

# -----------------------------------------------
# Node.js / npm
# -----------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# -----------------------------------------------
# Build Outputs
# -----------------------------------------------
dist/
build/
out/
.output/
.next/
.nuxt/

# -----------------------------------------------
# Environment Files (NEVER commit real secrets)
# -----------------------------------------------
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# -----------------------------------------------
# Python / FastAPI / AI Service
# -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
ai-service/venv/
ai-service/.venv/

# Python packaging
*.egg-info/
*.egg
dist/
build/
.eggs/
pip-wheel-metadata/

# MyPy / Pyright type cache
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# -----------------------------------------------
# Prisma / Database
# -----------------------------------------------
prisma/migrations/**/migration_lock.toml

# -----------------------------------------------
# IDEs & Editors
# -----------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
.DS_Store
Thumbs.db

# -----------------------------------------------
# Logs & Temp Files
# -----------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak

# -----------------------------------------------
# OS Generated
# -----------------------------------------------
.DS_Store
Desktop.ini
$RECYCLE.BIN/
